# ============================================================
#  Meridian — environment configuration
#  Copy this file to `.env.local` and fill in your values.
# ============================================================

# Your n8n workflow's PRODUCTION webhook URL.
# In n8n, open the "Webhook" trigger node → copy the Production URL.
# Example (local n8n):
#   N8N_WEBHOOK_URL=http://localhost:5678/webhook/market-research
# Example (n8n cloud):
#   N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/market-research
N8N_WEBHOOK_URL=

# How long (ms) to wait for the pipeline before timing out.
# Report generation can take a while — default is ~4.5 min.
N8N_TIMEOUT_MS=280000

# NOTE: If N8N_WEBHOOK_URL is left blank, the app runs in DEMO MODE and
# returns sample documents so you can preview the whole experience.
